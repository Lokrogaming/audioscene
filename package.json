{
  "name": "audioscene",
  "version": "0.3.0",
  "description": "AudioScene – OBS für Audio. Anwendungs-Audio & Geräte als Quellen mischen und aufnehmen.",
  "main": "main.js",
  "author": "Lokrogaming",
  "license": "MIT",
  "repository": "https://github.com/Lokrogaming/audioscene",
  "homepage": "https://lokrogaming.github.io/audioscene/",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "node scripts/make-icon.cjs",
    "dist": "electron-builder --win nsis portable",
    "dist:portable": "electron-builder --win portable zip"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.lokrogaming.audioscene",
    "productName": "AudioScene",
    "copyright": "Copyright © 2026 Lokrogaming",
    "win": {
      "icon": "assets/icon.ico",
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AudioScene",
      "uninstallDisplayName": "AudioScene – OBS für Audio",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName} ${version} Portable.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  }
}
